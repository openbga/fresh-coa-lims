# OpenBGA Fresh CoA LIMS environment variables (safe local examples).
# Settings read the process environment only. For local development copy this file to .env
# (ignored by Git) and let uv load it for every `uv run` command:
#   cp .env.example .env && export UV_ENV_FILE=.env
# Never commit a real .env file or any production secret.
# Commented lines show the built-in default.

# --- Core ---
# Development mode. Leave unset or false on any shared or public instance: false enables
# HTTPS redirects, secure cookies and HSTS.
DEBUG=true
# Required when DEBUG is false: a long random value unique to each deployment.
# With DEBUG=true an empty value falls back to a fixed development-only key.
SECRET_KEY=
# PostgreSQL connection URL (the local Compose database by default).
DATABASE_URL=postgresql://open_qual:open_qual@127.0.0.1:55433/open_qual
# Comma-separated host names the site answers to.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins trusted for form posts behind a proxy, e.g. https://qc.example.com
# CSRF_TRUSTED_ORIGINS=
# IANA time zone name.
TIME_ZONE=UTC
# Set by Render: added to ALLOWED_HOSTS and, as https://..., to CSRF_TRUSTED_ORIGINS.
# RENDER_EXTERNAL_HOSTNAME=

# --- Sessions and sign-in ---
# Controlled sessions end after this idle time and this total time (60 <= idle <= absolute).
# SESSION_IDLE_SECONDS=900
# SESSION_ABSOLUTE_SECONDS=28800
# Consecutive failed passwords that lock an account's password sign-in, and the lock
# duration in seconds (>= 60).
# LOGIN_FAILURE_LIMIT=5
# LOGIN_LOCK_SECONDS=900

# --- HTTPS (used only when DEBUG is false) ---
# HSTS max-age in seconds; subdomain and preload scope are explicit choices.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false

# --- Email ---
# Default: console backend with DEBUG=true, no delivery (dummy backend) otherwise.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=noreply@example.invalid

# --- Product ---
# Source link in every page footer (AGPL-3.0 section 13). Point it at your own repository
# when you deploy a modified version.
# SOURCE_CODE_URL=https://github.com/openbga/freshcoa
# Print a synthetic-data notice on issued certificates (PDF).
# REPORT_SYNTHETIC_DATA_NOTICE=true

# --- macOS with Homebrew ---
# WeasyPrint (PDF certificates) loads Pango from Homebrew. Uncomment if Python reports
# "cannot load library 'libgobject-2.0-0'"; use /usr/local/lib on Intel Macs. It must be set
# here (or with `uv run --env-file`): uv does not pass an exported DYLD_* variable on.
# DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib

# --- Tests ---
# Name of the database pytest creates; must start with test_ and differ from DATABASE_URL's.
# TEST_DATABASE_NAME=test_open_qual

# --- Container image command ---
# Port and number of gunicorn workers.
# PORT=8000
# WEB_CONCURRENCY=2

# --- Docker Compose host ports (local only, bound to 127.0.0.1) ---
# DB_PORT=55433
# WEB_PORT=8000
